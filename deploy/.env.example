# Isolate Compose project (avoid clashing with seedao-v1-web / seedao-v1-app / other stacks)
COMPOSE_PROJECT_NAME=seedao-v1-claim

# Host port (must match Nginx proxy_pass). Default 3082
# (seedao-v1-web uses 3080, seedao-v1-app uses 3081).
HOST_PORT=3082

# Pre-built image from GitHub Actions (required).
# After first successful workflow run, replace OWNER/REPO with your GitHub path (lowercase).
# Examples:
#   WEB_IMAGE=ghcr.io/seedao-polis/seedao-v1-claim:latest
#   WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/seedao-v1-claim:latest
WEB_IMAGE=ghcr.io/OWNER/REPO:latest
